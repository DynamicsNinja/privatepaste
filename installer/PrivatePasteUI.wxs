<!--
  The installer's dialogs in the Night vault look: dark artwork (installer/art, passed in as -d ArtDir=<folder>) with
  light text on it. Used by PrivatePaste.wxs and by the UI preview (installer/preview), which needs no app build.

  Why copies of the WixUI dialogs: the stock ones draw their titles and descriptions in WixUI_Font_*, and
  WixUI_Font_Normal is also the body text on the light system background, so no single color works on both. The copies
  below are the WiX 6.0.2 WixUI dialogs (github.com/wixtoolset/wix, src/ext/UI/wixlib, the version pinned in
  build-installer.ps1) with the same controls, conditions, Publish events and UI sequence entries; only the text
  styles, a few strings (sentence case, PrivatePaste's own words) and the Launch checkbox (a box plus a light label:
  a checkbox draws a light system background behind its own text) differ.
  They are renamed PP_* so the stock fragments, which define the same ids, are never linked. FilesInUse and
  MsiRMFilesInUse keep their names because Windows Installer finds them by name; nothing references the stock ones.
  Dialogs without artwork (CancelDlg, ErrorDlg, WaitForCostingDlg) stay stock.

  Text on the artwork uses the PP_*_Light styles (titles in the text color, descriptions muted); text on the light
  system background keeps the default dark font. Tahoma, because MSI dialogs can't load Sora.
  Banner text must end before X=325 (the logo tile sits at the right of banner.bmp); on full-page dialogs it starts
  at X=135, right of the brand column in dialog.bmp.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <WixVariable Id="WixUIDialogBmp" Value="$(var.ArtDir)\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.ArtDir)\banner.bmp" />

    <!-- WixUI_Minimal without the licence page (the MIT licence needs no click-through): Welcome, progress, finish. -->
    <UI Id="PrivatePaste_UI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <!-- DESIGN.md dark tokens: muted #9A94BD; text #E9E6F7 is drawn as #E2DEF4, a shade dimmer. Windows Installer
           (Windows 11, tested) silently falls back to black for some very light colors close to the light system
           background: #E9E6F7, #E6E3F6, #F7F5FF and #F0F0F0 all came out black, #E2DEF4, #DCD8F0 and #FFFFFF stay light.
           Check the preview (installer/preview) after changing these. -->
      <TextStyle Id="PP_Font_Bigger_Light" FaceName="Tahoma" Size="12" Red="226" Green="222" Blue="244" />
      <TextStyle Id="PP_Font_Title_Light" FaceName="Tahoma" Size="9" Bold="yes" Red="226" Green="222" Blue="244" />
      <TextStyle Id="PP_Font_Text_Light" FaceName="Tahoma" Size="8" Red="226" Green="222" Blue="244" />
      <TextStyle Id="PP_Font_Normal_Light" FaceName="Tahoma" Size="8" Red="154" Green="148" Blue="189" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="PP_FatalErrorDlg" />
      <DialogRef Id="PP_PrepareDlg" />
      <DialogRef Id="PP_ProgressDlg" />
      <DialogRef Id="PP_ResumeDlg" />
      <DialogRef Id="PP_UserExitDlg" />
      <DialogRef Id="PP_WelcomeDlg" />

      <Publish Dialog="PP_WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Condition="NOT Installed" />

      <Publish Dialog="PP_ExitDlg" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="PP_ExitDlg" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="PP_VerifyReadyDlg" Control="Back" Event="NewDialog" Value="PP_MaintenanceTypeDlg" />
      <Publish Dialog="PP_MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="PP_MaintenanceTypeDlg" />
      <Publish Dialog="PP_MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="PP_VerifyReadyDlg" />
      <Publish Dialog="PP_MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="PP_VerifyReadyDlg" />
      <Publish Dialog="PP_MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="PP_MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <!-- FilesInUse and MsiRMFilesInUse: Windows Installer shows the dialogs with these exact names, so they keep the
         stock ids. They live in this fragment, unreferenced by id: a DialogRef would also match the stock fragments, and
         so would a reference to the stock WixUIRMOption property (hence PP_RMOption). -->
    <UI>
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="!(loc.FilesInUse_Title)" KeepModeless="yes">
        <Control Id="Retry" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIRetry)">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="235" Y="243" Width="56" Height="17" Text="!(loc.WixUIIgnore)">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="166" Y="243" Width="56" Height="17" Text="!(loc.FilesInUseExit)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.FilesInUseBannerBitmap)" />
        <Control Id="Text" Type="Text" X="20" Y="55" Width="330" Height="30" Text="!(loc.FilesInUseText)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="20" Y="23" Width="280" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}!(loc.FilesInUseDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Title_Light}Files in Use" />
        <Control Id="List" Type="ListBox" X="20" Y="87" Width="330" Height="130" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
      </Dialog>
    </UI>

    <UI>
      <Property Id="PP_RMOption" Value="UseRM" />
      <Dialog Id="MsiRMFilesInUse" Width="370" Height="270" Title="!(loc.MsiRMFilesInUse_Title)" KeepModeless="yes">
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
          <Publish Event="RMShutdownAndRestart" Value="0" Condition="PP_RMOption~=&quot;UseRM&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>

        <Control Id="ShutdownOption" Type="RadioButtonGroup" X="26" Y="190" Width="305" Height="45" Property="PP_RMOption">
          <RadioButtonGroup Property="PP_RMOption">
            <RadioButton Value="UseRM" X="0" Y="0" Width="295" Height="16" Text="!(loc.MsiRMFilesInUseUseRM)" />
            <RadioButton Value="DontUseRM" X="0" Y="20" Width="295" Height="16" Text="!(loc.MsiRMFilesInUseDontUseRM)" />
          </RadioButtonGroup>
        </Control>

        <Control Id="List" Type="ListBox" X="20" Y="100" Width="330" Height="80" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.MsiRMFilesInUseBannerBitmap)" />
        <Control Id="Text" Type="Text" X="20" Y="55" Width="330" Height="45" Text="!(loc.MsiRMFilesInUseText)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="20" Y="23" Width="280" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}!(loc.MsiRMFilesInUseDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Title_Light}Files in Use" />
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>

  <!-- WelcomeDlg -->
  <Fragment>
    <UI>
      <Dialog Id="PP_WelcomeDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <!-- "Install": Next ends the UI and starts installing (see the Publish in PrivatePaste_UI). -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.ResumeDlgInstall)">
          <Publish Property="WixUI_InstallMode" Value="Update" Condition="Installed AND PATCH" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.WelcomeDlgBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}This installs [ProductName] for your Windows account. It doesn't need administrator rights."
                 ShowCondition="NOT Installed OR NOT PATCH" HideCondition="Installed AND PATCH" />
        <Control Id="Description2" Type="Text" X="135" Y="115" Width="220" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}Click Install to continue, or Cancel to exit."
                 ShowCondition="NOT Installed OR NOT PATCH" HideCondition="Installed AND PATCH" />
        <Control Id="PatchDescription" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}The Setup Wizard will update [ProductName] on your computer. Click Install to continue or Cancel to exit the Setup Wizard."
                 ShowCondition="Installed AND PATCH" HideCondition="NOT Installed OR NOT PATCH" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Bigger_Light}Welcome to [ProductName] Setup" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="PP_WelcomeDlg" Before="PP_ProgressDlg" Condition="NOT Installed OR PATCH" />
      </InstallUISequence>
    </UI>
  </Fragment>

  <!-- PrepareDlg -->
  <Fragment>
    <UI>
      <Dialog Id="PP_PrepareDlg" Width="370" Height="270" Title="!(loc.PrepareDlg_Title)" Modeless="yes">
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.PrepareDlgBitmap)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}!(loc.PrepareDlgDescription)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Bigger_Light}Welcome to [ProductName] Setup" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" TabSkip="yes" Text="!(loc.WixUINext)" />
        <!-- The style set here is kept when the subscribed event replaces the text. -->
        <Control Id="ActionData" Type="Text" X="135" Y="125" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{\PP_Font_Normal_Light}">
          <Subscribe Event="ActionData" Attribute="Text" />
        </Control>
        <Control Id="ActionText" Type="Text" X="135" Y="100" Width="220" Height="20" Transparent="yes" NoPrefix="yes" Text="{\PP_Font_Normal_Light}">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="PP_PrepareDlg" Before="AppSearch" />
      </InstallUISequence>
    </UI>
  </Fragment>

  <!-- ProgressDlg. Title and description sit in the banner, as on the other banner pages; status and bar below. -->
  <Fragment>
    <UI>
      <Dialog Id="PP_ProgressDlg" Width="370" Height="270" Title="!(loc.ProgressDlg_Title)" Modeless="yes">
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.ProgressDlgBannerBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUINext)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <!-- mutually exclusive title and description strings overlap -->
        <Control Id="TextInstalling" Type="Text" X="25" Y="23" Width="295" Height="20" Transparent="yes" Hidden="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}Please wait while [ProductName] is installed."
                 ShowCondition="NOT Installed OR (Installed AND (RESUME OR Preselected) AND NOT PATCH)" />
        <Control Id="TitleInstalling" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Title_Light}Installing [ProductName]"
                 ShowCondition="NOT Installed OR (Installed AND (RESUME OR Preselected) AND NOT PATCH)" />
        <Control Id="TextChanging" Type="Text" X="25" Y="23" Width="295" Height="20" Transparent="yes" Hidden="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}Please wait while [ProductName] is changed."
                 ShowCondition="WixUI_InstallMode = &quot;Change&quot;" />
        <Control Id="TitleChanging" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Title_Light}Changing [ProductName]"
                 ShowCondition="WixUI_InstallMode = &quot;Change&quot;" />
        <Control Id="TextRepairing" Type="Text" X="25" Y="23" Width="295" Height="20" Transparent="yes" Hidden="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}Please wait while [ProductName] is repaired."
                 ShowCondition="WixUI_InstallMode = &quot;Repair&quot;" />
        <Control Id="TitleRepairing" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Title_Light}Repairing [ProductName]"
                 ShowCondition="WixUI_InstallMode = &quot;Repair&quot;" />
        <Control Id="TextRemoving" Type="Text" X="25" Y="23" Width="295" Height="20" Transparent="yes" Hidden="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}Please wait while [ProductName] is removed."
                 ShowCondition="WixUI_InstallMode = &quot;Remove&quot;" />
        <Control Id="TitleRemoving" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Title_Light}Removing [ProductName]"
                 ShowCondition="WixUI_InstallMode = &quot;Remove&quot;" />
        <Control Id="TextUpdating" Type="Text" X="25" Y="23" Width="295" Height="20" Transparent="yes" Hidden="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}Please wait while [ProductName] is updated."
                 ShowCondition="WixUI_InstallMode = &quot;Update&quot;" />
        <Control Id="TitleUpdating" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Title_Light}Updating [ProductName]"
                 ShowCondition="WixUI_InstallMode = &quot;Update&quot;" />
        <Control Id="ActionText" Type="Text" X="70" Y="100" Width="285" Height="10">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="115" Width="330" Height="10" ProgressBlocks="yes" Text="!(loc.ProgressDlgProgressBar)">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="StatusLabel" Type="Text" X="20" Y="100" Width="50" Height="10" Text="!(loc.ProgressDlgStatusLabel)" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="PP_ProgressDlg" Before="ExecuteAction" />
      </InstallUISequence>
    </UI>
  </Fragment>

  <!-- ExitDialog. Also shown after a repair or a removal, so the title says which. -->
  <Fragment>
    <UI>
      <Dialog Id="PP_ExitDlg" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Normal_Light}Click Finish to close Setup. [ProductName] starts in the tray; sign in there with your server, your name and your password."
                 ShowCondition="NOT Installed" />
        <Control Id="MaintenanceDescription" Type="Text" X="135" Y="70" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Normal_Light}Click Finish to close Setup."
                 ShowCondition="Installed" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Bigger_Light}[ProductName] is installed"
                 ShowCondition="NOT Installed" />
        <Control Id="RepairTitle" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Bigger_Light}[ProductName] is repaired"
                 ShowCondition="Installed AND WixUI_InstallMode = &quot;Repair&quot;" />
        <Control Id="RemoveTitle" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Bigger_Light}[ProductName] is removed"
                 ShowCondition="Installed AND WixUI_InstallMode = &quot;Remove&quot;" />
        <Control Id="OtherTitle" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Bigger_Light}Completed the [ProductName] Setup Wizard"
                 ShowCondition="Installed AND WixUI_InstallMode &lt;&gt; &quot;Repair&quot; AND WixUI_InstallMode &lt;&gt; &quot;Remove&quot;" />
        <Control Id="OptionalText" Type="Text" X="135" Y="110" Width="220" Height="80" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Normal_Light}[WIXUI_EXITDIALOGOPTIONALTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALTEXT AND NOT Installed" />
        <!-- Just the box: a checkbox paints the system background behind its own text, a grey bar on the artwork. -->
        <Control Id="OptionalCheckBox" Type="CheckBox" X="135" Y="190" Width="10" Height="10" Hidden="yes" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX"
                 CheckBoxValue="1" ToolTip="[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT AND NOT Installed" />
        <Control Id="OptionalCheckBoxText" Type="Text" X="149" Y="191" Width="206" Height="10" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\PP_Font_Text_Light}[WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT]" ShowCondition="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT AND NOT Installed" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="PP_ExitDlg" OnExit="success" />
      </InstallUISequence>

      <AdminUISequence>
        <Show Dialog="PP_ExitDlg" OnExit="success" />
      </AdminUISequence>
    </UI>
  </Fragment>

  <!-- UserExit -->
  <Fragment>
    <UI>
      <Dialog Id="PP_UserExitDlg" Width="370" Height="270" Title="!(loc.UserExit_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.UserExitBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Bigger_Light}[ProductName] Setup Wizard was interrupted" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="80" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}!(loc.UserExitDescription1) !(loc.UserExitDescription2)" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="PP_UserExitDlg" OnExit="cancel" />
      </InstallUISequence>

      <AdminUISequence>
        <Show Dialog="PP_UserExitDlg" OnExit="cancel" />
      </AdminUISequence>
    </UI>
  </Fragment>

  <!-- FatalError -->
  <Fragment>
    <UI>
      <Dialog Id="PP_FatalErrorDlg" Width="370" Height="270" Title="!(loc.FatalError_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.FatalErrorBitmap)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Bigger_Light}[ProductName] Setup Wizard ended prematurely" />
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="80" Transparent="yes" NoPrefix="yes"
                 Text="{\PP_Font_Normal_Light}!(loc.FatalErrorDescription1) !(loc.FatalErrorDescription2)" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="PP_FatalErrorDlg" OnExit="error" />
      </InstallUISequence>

      <AdminUISequence>
        <Show Dialog="PP_FatalErrorDlg" OnExit="error" />
      </AdminUISequence>
    </UI>
  </Fragment>

  <!-- ResumeDlg -->
  <Fragment>
    <UI>
      <Dialog Id="PP_ResumeDlg" Width="370" Height="270" Title="!(loc.ResumeDlg_Title)">
