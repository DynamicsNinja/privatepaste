<!--
  Per-user MSI for the PrivatePaste desktop app (WiX Toolset, pinned in .config/dotnet-tools.json).
  Build it with scripts/build-installer.ps1, which passes:
    -d Version=x.y.z         MSI ProductVersion (prerelease suffix already stripped)
    -d ExePath=<path>        the single-file PrivatePaste.exe from publish-windows.ps1
    -d IconPath=<path>       src/PrivatePaste.Desktop/Assets/app.ico
    -d ArtDir=<folder>       installer/art (dialog.bmp, banner.bmp)
  together with PrivatePasteUI.wxs, the dialogs (PrivatePaste_UI).

  Installs to %LOCALAPPDATA%\Programs\PrivatePaste\PrivatePaste.exe. That path is fixed: the
  autostart value the app writes and managed PCs' Defender ASR exclusions point at it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- UpgradeCode: NEVER change this GUID. It is how a newer MSI finds and replaces an installed one;
       a new value would install side by side instead of upgrading. -->
  <Package Name="PrivatePaste"
           Manufacturer="ficdev"
           Version="$(var.Version)"
           UpgradeCode="6C84E8A6-1BFE-4A70-B72C-9B6AFCB953B7"
           Scope="perUser"
           Language="1033">

    <!-- Same-version upgrades are allowed so the final x.y.z replaces x.y.z-rc (both map to MSI x.y.z). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallValidate"
                  DowngradeErrorMessage="A newer version of PrivatePaste is already installed. To go back to this version, uninstall PrivatePaste in Settings &gt; Apps first." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- File costing runs before RemoveExistingProducts and, by default, keeps an exe of the same file version.
         An RC and its final (0.2.0-rc1 / 0.2.0 both stamp 0.2.0.0), or a hand-copied exe at the install path, would
         then be kept and deleted with the old product: always copy our files instead (ICE40 warning is expected). -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Add/Remove Programs -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/DynamicsNinja/privatepaste" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DynamicsNinja/privatepaste" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PrivatePaste" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="PrivatePaste" AllowAbsent="no">
      <!-- Components under the user profile need an HKCU key path (ICE38) and RemoveFolder entries (ICE64).
           A registry key path rules out a generated GUID, so this one is fixed; keep it unchanged. -->
      <Component Id="AppExe" Directory="INSTALLFOLDER" Guid="29C51544-ED71-4A27-B03B-8541A37E0B65">
        <File Id="PrivatePasteExe" Source="$(var.ExePath)" Name="PrivatePaste.exe" />
        <Shortcut Id="PrivatePasteShortcut" Directory="ProgramMenuFolder" Name="PrivatePaste"
                  Description="Self-hosted clipboard sync" Target="[#PrivatePasteExe]"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\ficdev\PrivatePaste" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <!-- Only removed when empty, so other apps in %LOCALAPPDATA%\Programs are safe. -->
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>
    </Feature>

    <!-- End a running PrivatePaste before InstallValidate, so its files-in-use check does not stop on it.
         It runs on every install, upgrade, repair and uninstall: a plain first install can also meet a running
         hand-copied exe at the same path. The app has no graceful-quit signal (no quit switch, named event or pipe),
         so it is ended with taskkill. Exit code 128 (not running) is ignored. -->
    <SetProperty Id="WixQuietExecCmdLine" Sequence="execute" Before="EndPrivatePaste"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /f /im PrivatePaste.exe" />
    <CustomAction Id="EndPrivatePaste" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="EndPrivatePaste" Before="InstallValidate" />
    </InstallExecuteSequence>

    <!-- Backstop: if the app was started again in between, terminate it before files are replaced or removed. -->
    <util:CloseApplication Id="ClosePrivatePaste" Target="PrivatePaste.exe" CloseMessage="no"
                           TerminateProcess="1" RebootPrompt="no" />

    <!-- Kill the running app at the start of the script, before RemoveFiles (the extension's default, before
         InstallFiles, comes after an uninstall has already tried to remove the exe). It must not sit between
         InstallInitialize and RemoveExistingProducts (error 2613), so the upgrade removal runs after InstallValidate. -->
    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_X64" After="InstallInitialize" />
    </InstallExecuteSequence>

    <!-- On a real uninstall (not the uninstall half of an upgrade) remove the "Start with Windows" value the
         app writes, so no autostart entry points at a deleted exe. %APPDATA%\PrivatePaste is left alone. -->
    <SetProperty Id="RemoveAutostart" Sequence="execute" Before="RemoveAutostart"
                 Value="&quot;[System64Folder]reg.exe&quot; delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v PrivatePaste /f" />
    <CustomAction Id="RemoveAutostart" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveAutostart" Before="RemoveRegistryValues"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Launch the app from the "Launch PrivatePaste" checkbox on the last page. -->
    <Property Id="WixShellExecTarget" Value="[#PrivatePasteExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PrivatePaste" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Night vault dialogs: installer/PrivatePasteUI.wxs. -->
    <UIRef Id="PrivatePaste_UI" />
  </Package>

</Wix>
