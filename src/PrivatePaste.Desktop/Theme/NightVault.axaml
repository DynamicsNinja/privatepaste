<!-- Night vault brand theme (branding/README.md). Dark is the default; the Light dictionary is the light variant. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Tokens from branding/README.md ("OnAccent" and "AccentHover" are derived for the primary button). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="PpNightColor">#15122B</Color>
          <Color x:Key="PpSurfaceColor">#1D1838</Color>
          <Color x:Key="PpRaisedColor">#262046</Color>
          <Color x:Key="PpLineColor">#2E2756</Color>
          <Color x:Key="PpTextColor">#E9E6F7</Color>
          <Color x:Key="PpMutedColor">#9A94BD</Color>
          <Color x:Key="PpAccentColor">#B7A5FF</Color>
          <Color x:Key="PpDangerColor">#FF8FA3</Color>
          <Color x:Key="PpLiveColor">#7CE0C3</Color>
          <Color x:Key="PpOnAccentColor">#15122B</Color>
          <Color x:Key="PpAccentHoverColor">#C6B8FF</Color>
          <SolidColorBrush x:Key="PpNight" Color="#15122B" />
          <SolidColorBrush x:Key="PpSurface" Color="#1D1838" />
          <SolidColorBrush x:Key="PpRaised" Color="#262046" />
          <SolidColorBrush x:Key="PpLine" Color="#2E2756" />
          <SolidColorBrush x:Key="PpText" Color="#E9E6F7" />
          <SolidColorBrush x:Key="PpMuted" Color="#9A94BD" />
          <SolidColorBrush x:Key="PpAccent" Color="#B7A5FF" />
          <SolidColorBrush x:Key="PpDanger" Color="#FF8FA3" />
          <SolidColorBrush x:Key="PpLive" Color="#7CE0C3" />
          <SolidColorBrush x:Key="PpOnAccent" Color="#15122B" />
          <SolidColorBrush x:Key="PpAccentHover" Color="#C6B8FF" />
          <SolidColorBrush x:Key="PpChipBackground" Color="#332B63" />
          <!-- Fluent accent: focus rings, checkbox fill and selection use the brand accent. -->
          <Color x:Key="SystemAccentColor">#B7A5FF</Color>
          <Color x:Key="SystemAccentColorDark1">#A592F5</Color>
          <Color x:Key="SystemAccentColorLight1">#C6B8FF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="PpNightColor">#F6F4FD</Color>
          <Color x:Key="PpSurfaceColor">#FFFFFF</Color>
          <Color x:Key="PpRaisedColor">#EFEBFC</Color>
          <Color x:Key="PpLineColor">#E1DBF7</Color>
          <Color x:Key="PpTextColor">#1E1A38</Color>
          <Color x:Key="PpMutedColor">#625C88</Color>
          <Color x:Key="PpAccentColor">#5B45D6</Color>
          <Color x:Key="PpDangerColor">#C2364A</Color>
          <Color x:Key="PpLiveColor">#7CE0C3</Color>
          <Color x:Key="PpOnAccentColor">#FFFFFF</Color>
          <Color x:Key="PpAccentHoverColor">#4A36C0</Color>
          <SolidColorBrush x:Key="PpNight" Color="#F6F4FD" />
          <SolidColorBrush x:Key="PpSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PpRaised" Color="#EFEBFC" />
          <SolidColorBrush x:Key="PpLine" Color="#E1DBF7" />
          <SolidColorBrush x:Key="PpText" Color="#1E1A38" />
          <SolidColorBrush x:Key="PpMuted" Color="#625C88" />
          <SolidColorBrush x:Key="PpAccent" Color="#5B45D6" />
          <SolidColorBrush x:Key="PpDanger" Color="#C2364A" />
          <SolidColorBrush x:Key="PpLive" Color="#7CE0C3" />
          <SolidColorBrush x:Key="PpOnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PpAccentHover" Color="#4A36C0" />
          <SolidColorBrush x:Key="PpChipBackground" Color="#E6E0FA" />
          <!-- Fluent accent: focus rings, checkbox fill and selection use the brand accent. -->
          <Color x:Key="SystemAccentColor">#5B45D6</Color>
          <Color x:Key="SystemAccentColorDark1">#4A36C0</Color>
          <Color x:Key="SystemAccentColorLight1">#7461E0</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="PpFont">avares://PrivatePaste/Assets/Fonts#Sora</FontFamily>
      <CornerRadius x:Key="PpPanelRadius">14</CornerRadius>
      <CornerRadius x:Key="PpControlRadius">10</CornerRadius>
      <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

      <!-- Source device platform icons, the path data of branding/platform-icons/*.svg (24x24, drawn with a 2px round
           stroke, never filled). Keys follow Theme/PlatformIcons.cs; a test keeps them in sync with the SVGs. -->
      <StreamGeometry x:Key="PpPlatformWindows">M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z</StreamGeometry>
      <StreamGeometry x:Key="PpPlatformMacos">M9 9h6v6H9zM9 9V6a3 3 0 1 0-3 3h3M15 9V6a3 3 0 1 1 3 3h-3M15 15v3a3 3 0 1 0 3-3h-3M9 15v3a3 3 0 1 1-3-3h3</StreamGeometry>
      <StreamGeometry x:Key="PpPlatformLinux">M4 6l6 6-6 6M12 18h8</StreamGeometry>
      <StreamGeometry x:Key="PpPlatformAndroid">M3 18.5a9 9 0 0 1 18 0zM7.5 10.7 5.5 7.2M16.5 10.7 18.5 7.2M8.5 14.5h.01M15.5 14.5h.01</StreamGeometry>
      <StreamGeometry x:Key="PpPlatformWeb">M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0zM3 12h18M12 3c-2.5 2.4-3.8 5.4-3.8 9s1.3 6.6 3.8 9M12 3c2.5 2.4 3.8 5.4 3.8 9s-1.3 6.6-3.8 9</StreamGeometry>
      <StreamGeometry x:Key="PpPlatformUnknown">M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM12 16v4M8 20h8</StreamGeometry>
      <!-- branding/ui-icons/pin.svg, same rules (a test keeps it in sync). -->
      <StreamGeometry x:Key="PpIconPin">M12 17v5M9 3h6l-1 6 3 3v2H7v-2l3-3z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PpNight}" />
    <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    <Setter Property="FontFamily" Value="{StaticResource PpFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource PpMuted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="2,0,0,6" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource PpDanger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PpSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PpPanelRadius}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Inputs: raised fill, line border, accent border on focus. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
    <Setter Property="CornerRadius" Value="{StaticResource PpControlRadius}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontFamily" Value="{StaticResource PpFont}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpMuted}" />
  </Style>
  <!-- .typing: the Windows popup's search box, which takes keys from the hook and never has the focus; looks focused. -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox.typing /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:readonly /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource PpSurface}" />
  </Style>
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource PpText}" />
  </Style>

  <!-- Buttons: secondary by default; .primary is the accent button; .danger turns red on hover/focus only. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PpControlRadius}" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource PpFont}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PpLine}" />
    <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PpAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource PpOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PpAccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource PpOnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource PpMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource PpDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PpDanger}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    <Setter Property="FontFamily" Value="{StaticResource PpFont}" />
  </Style>

  <!-- Custom title bar caption buttons (Views/TitleBar): flat, hover = raised, close hover = danger. -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="35" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
  </Style>
  <Style Selector="Button.caption Path">
    <Setter Property="Stroke" Value="{DynamicResource PpText}" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PpLine}" />
  </Style>
  <Style Selector="Button.caption:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PpDanger}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover Path, Button.caption.close:pressed Path">
    <Setter Property="Stroke" Value="#FFFFFF" />
  </Style>
</Styles>
