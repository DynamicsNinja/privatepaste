<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrivatePaste.Desktop.ViewModels"
        xmlns:views="using:PrivatePaste.Desktop.Views"
        x:Class="PrivatePaste.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="PrivatePaste settings"
        Icon="avares://PrivatePaste/Assets/app.ico"
        Width="460" MinWidth="400" MinHeight="460" SizeToContent="Height" CanResize="True"
        ExtendClientAreaToDecorationsHint="True" WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <views:TitleBar DockPanel.Dock="Top" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28" Spacing="20" MaxWidth="460">
        <views:Wordmark HorizontalAlignment="Left" />

        <TextBlock Classes="heading" Text="Settings" />

        <Border Classes="panel">
          <StackPanel Spacing="16">
            <StackPanel>
              <TextBlock Classes="label" Text="Server" />
              <TextBox Text="{Binding Server, Mode=OneWay}" IsReadOnly="True" />
              <TextBlock Margin="2,6,0,0" FontSize="12" Foreground="{DynamicResource PpMuted}">
                <Run Text="Signed in as " /><Run Text="{Binding DeviceName, Mode=OneWay}" Foreground="{DynamicResource PpText}" />
              </TextBlock>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="label" Text="History hotkey" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="HotkeyBox" Text="{Binding Hotkey}" />
                <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyHotkeyCommand}" />
              </Grid>
              <TextBlock Classes="error" Margin="2,6,0,0" FontSize="12" Text="{Binding HotkeyError}"
                         IsVisible="{Binding HotkeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <CheckBox IsChecked="{Binding StartWithOs}" Content="{Binding AutostartLabel}" />
              <CheckBox x:Name="NotifyOnClipArrivalBox" IsChecked="{Binding NotifyOnClipArrival}"
                        Content="Notify when a clip arrives" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="12">
            <TextBlock Classes="label" Text="Private copies" />

            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PpMuted}"
                       Text="{x:Static vm:SettingsViewModel.CannotBlockAppsMessage}" IsVisible="{Binding CannotBlockApps}" />

            <StackPanel Spacing="8" IsVisible="{Binding CanBlockApps}">
              <TextBlock Text="Ignore copies from these apps" />
              <TextBlock FontSize="12" Foreground="{DynamicResource PpMuted}" Text="No apps yet."
                         IsVisible="{Binding HasNoBlockedApps}" />
              <ItemsControl ItemsSource="{Binding BlockedApps}" IsVisible="{Binding HasBlockedApps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Content="Remove" Padding="12,6"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveBlockedAppCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsTypingApp}">
                <TextBox x:Name="TypedAppBox" Text="{Binding TypedApp}" PlaceholderText="App name, like keepassxc" />
                <Button Grid.Column="1" Content="Add" Classes="primary" Command="{Binding ConfirmTypedAppCommand}" />
                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelTypingAppCommand}" />
              </Grid>

              <Button x:Name="AddAppButton" Content="Add" HorizontalAlignment="Left"
                      IsVisible="{Binding !IsTypingApp}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Button Classes="danger" Content="Sign out" HorizontalAlignment="Left" Command="{Binding SignOutCommand}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
