<!-- Custom title bar in the Night vault brand: logo + window title on the left, minimize / maximize / close on the right.
     The window must use ExtendClientAreaToDecorationsHint and WindowDecorations=BorderOnly (macOS: Full, set in code). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrivatePaste.Desktop.Views.TitleBar"
             Height="36">
  <Border x:Name="Bar" Background="{DynamicResource PpNight}" BorderBrush="{DynamicResource PpLine}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel x:Name="TitlePanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0"
                  IsHitTestVisible="False">
        <Image Source="avares://PrivatePaste/Assets/app-icon-512.png" Width="16" Height="16"
               RenderOptions.BitmapInterpolationMode="HighQuality">
          <Image.Clip>
            <RectangleGeometry Rect="0,0,16,16" RadiusX="4" RadiusY="4" />
          </Image.Clip>
        </Image>
        <TextBlock x:Name="TitleText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PpMuted}"
                   FontFamily="{StaticResource PpFont}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel x:Name="Buttons" Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="MinimizeButton" Classes="caption" ToolTip.Tip="Minimize"
                AutomationProperties.Name="Minimize" Click="OnMinimize">
          <Path Data="M0,5 L10,5" Width="10" Height="10" StrokeThickness="1" />
        </Button>
        <Button x:Name="MaximizeButton" Classes="caption" ToolTip.Tip="Maximize"
                AutomationProperties.Name="Maximize" Click="OnMaximize">
          <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Width="10" Height="10"
                StrokeThickness="1" />
        </Button>
        <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="Close"
                AutomationProperties.Name="Close" Click="OnClose">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
