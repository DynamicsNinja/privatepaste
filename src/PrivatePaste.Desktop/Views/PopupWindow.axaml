<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrivatePaste.Desktop.ViewModels"
        xmlns:views="using:PrivatePaste.Desktop.Views"
        x:Class="PrivatePaste.Desktop.Views.PopupWindow"
        x:DataType="vm:PopupViewModel"
        Title="PrivatePaste history"
        WindowDecorations="None" Topmost="True" ShowInTaskbar="False" CanResize="False"
        Width="420" Height="520"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- The soft 3px glow of the newest clip (branding): accent at 16% alpha. -->
        <ResourceDictionary x:Key="Dark">
          <BoxShadows x:Key="PpGlow">0 0 0 3 #29B7A5FF</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <BoxShadows x:Key="PpGlow">0 0 0 3 #295B45D6</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource PpPanelRadius}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource PpSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource PpPanelRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.row">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PpMuted}" />
    </Style>
    <Style Selector="ListBoxItem Border.row.newest">
      <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource PpGlow}" />
    </Style>
    <Style Selector="Border.kind">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.kind, ListBoxItem:pointerover Border.kind">
      <Setter Property="Background" Value="{DynamicResource PpLine}" />
    </Style>
    <Style Selector="Path.platform">
      <Setter Property="Stroke" Value="{DynamicResource PpMuted}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- History / Pinned strip: plain borders, never focusable (the Windows popup must not take the focus). -->
    <Style Selector="Border.tab">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="{StaticResource PpControlRadius}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tab TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PpMuted}" />
    </Style>
    <Style Selector="Border.tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource PpSurface}" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    </Style>
    <Style Selector="Border.tab.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    </Style>
    <!-- Type filter chips: plain borders like the tabs. The active one gets the accent border, a raised fill and primary label. -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="{StaticResource PpControlRadius}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PpMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip Path, Border.chip Rectangle, Border.chip Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource PpMuted}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Border.chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource PpSurface}" />
    </Style>
    <Style Selector="Border.chip.active">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
    </Style>
    <Style Selector="Border.chip.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    </Style>
    <Style Selector="Border.chip.active Path, Border.chip.active Rectangle, Border.chip.active Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource PpAccent}" />
    </Style>
    <Style Selector="Button.pin">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PpLine}" />
    </Style>
    <Style Selector="Path.pinicon">
      <Setter Property="Stroke" Value="{DynamicResource PpMuted}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.pinicon.pinned">
      <Setter Property="Stroke" Value="{DynamicResource PpAccent}" />
    </Style>
    <Style Selector="Panel.icon Path, Panel.icon Rectangle, Panel.icon Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource PpAccent}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource PpNight}" BorderBrush="{DynamicResource PpLine}" BorderThickness="1"
          CornerRadius="{StaticResource PpPanelRadius}" Padding="12">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
      <!-- A stack, not a grid row: a hidden banner takes no space or spacing. -->
      <StackPanel Spacing="10">
        <!-- Why sync isn't running (an old app or server, a reset): the history below is what this computer still holds. -->
        <Border x:Name="BannerPanel" Background="{DynamicResource PpRaised}" CornerRadius="{StaticResource PpControlRadius}"
                Padding="12,8" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock x:Name="BannerText" Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource PpText}" />
        </Border>
        <TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="Search history" />
      </StackPanel>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
        <Border x:Name="HistoryTabButton" Classes="tab" Classes.active="{Binding IsHistoryTab}" Focusable="False">
          <TextBlock Text="History" />
        </Border>
        <Border x:Name="PinnedTabButton" Classes="tab" Classes.active="{Binding IsPinnedTab}" Focusable="False">
          <TextBlock Text="Pinned" />
        </Border>
      </StackPanel>

      <!-- Type filter (Alt+1 to Alt+5): All, Text, Links, Images, Files. Icons as in the rows. -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
        <Border x:Name="FilterAllChip" Classes="chip" Classes.active="{Binding IsAllFilter}" Focusable="False">
          <TextBlock Text="All" />
        </Border>
        <Border x:Name="FilterTextChip" Classes="chip" Classes.active="{Binding IsTextFilter}" Focusable="False">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Data="M5 6h14M5 12h14M5 18h9" /></Canvas></Viewbox>
            <TextBlock Text="Text" />
          </StackPanel>
        </Border>
        <Border x:Name="FilterLinkChip" Classes="chip" Classes.active="{Binding IsLinkFilter}" Focusable="False">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Viewbox Width="13" Height="13">
              <Canvas Width="24" Height="24">
                <Path Data="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" />
                <Path Data="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Links" />
          </StackPanel>
        </Border>
        <Border x:Name="FilterImageChip" Classes="chip" Classes.active="{Binding IsImageFilter}" Focusable="False">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Viewbox Width="13" Height="13">
              <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="16" RadiusX="3" RadiusY="3" />
                <Ellipse Canvas.Left="7" Canvas.Top="8" Width="4" Height="4" />
                <Path Data="M21 16l-5-5-9 9" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Images" />
          </StackPanel>
        </Border>
        <Border x:Name="FilterFileChip" Classes="chip" Classes.active="{Binding IsFileFilter}" Focusable="False">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Viewbox Width="13" Height="13">
              <Canvas Width="24" Height="24"><Path Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5" /></Canvas>
            </Viewbox>
            <TextBlock Text="Files" />
          </StackPanel>
        </Border>
      </StackPanel>

      <ListBox x:Name="ItemsList" Grid.Row="3" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}"
               Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PopupItem">
            <Border Classes="row" Classes.newest="{Binding IsNewest}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="kind" VerticalAlignment="Top">
                  <Panel>
                    <Viewbox Width="18" Height="18">
                      <Panel Classes="icon" Width="24" Height="24">
                        <Canvas IsVisible="{Binding IsImage}">
                          <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="16" RadiusX="3" RadiusY="3" />
                          <Ellipse Canvas.Left="7" Canvas.Top="8" Width="4" Height="4" />
                          <Path Data="M21 16l-5-5-9 9" />
                        </Canvas>
                        <Canvas IsVisible="{Binding IsLink}">
                          <Path Data="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" />
                          <Path Data="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
                        </Canvas>
                        <Canvas IsVisible="{Binding IsText}">
                          <Path Data="M5 6h14M5 12h14M5 18h9" />
                        </Canvas>
                        <!-- branding/ui-icons/kind-file.svg -->
                        <Canvas x:Name="FileIcon" IsVisible="{Binding IsFile}">
                          <Path Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5" />
                        </Canvas>
                        <!-- A clip this app can't show: a question mark. -->
                        <Canvas IsVisible="{Binding IsUnknown}">
                          <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" />
                          <Path Data="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01" />
                        </Canvas>
                        <!-- Search older clips: a magnifier. -->
                        <Canvas IsVisible="{Binding IsSearchOlder}">
                          <Ellipse Canvas.Left="4" Canvas.Top="4" Width="13" Height="13" />
                          <Path Data="M20 20l-4.2-4.2" />
                        </Canvas>
                      </Panel>
                    </Viewbox>
                    <Image Source="{Binding Thumbnail, Converter={x:Static views:PopupWindow.ThumbnailConverter}}"
                           Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <!-- Spacing is per element margin, so a hidden chip or pin leaves no gap. -->
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsClip}">
                    <!-- Who copied it; a plain Border so nothing in the popup can take the focus. -->
                    <Border x:Name="PersonChip" Background="{DynamicResource PpChipBackground}"
                            CornerRadius="9" Padding="7,1" Margin="0,0,5,0" VerticalAlignment="Center"
                            IsVisible="{Binding Person, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Person}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PpText}"
                                 MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                    </Border>
                    <!-- Source device platform, about the cap height of the 12px meta text. -->
                    <Viewbox Grid.Column="1" x:Name="PlatformIcon" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding Platform.Label}" ToolTip.Tip="{Binding Platform.Label}">
                      <Canvas Width="24" Height="24">
                        <Path Classes="platform"
                              Data="{Binding Platform.ResourceKey, Converter={x:Static views:PopupWindow.ResourceConverter}}" />
                      </Canvas>
                    </Viewbox>
                    <!-- Marks a pinned clip (the button on the right toggles it). -->
                    <Viewbox Grid.Column="2" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" IsVisible="{Binding IsPinned}">
                      <Canvas Width="24" Height="24">
                        <Path Classes="pinicon pinned" Data="{StaticResource PpIconPin}" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="3" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource PpMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
                <Button Grid.Column="2" Classes="pin" AutomationProperties.Name="{Binding PinLabel}" ToolTip.Tip="{Binding PinLabel}"
                        IsVisible="{Binding IsClip}">
                  <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                      <Path Classes="pinicon" Classes.pinned="{Binding IsPinned}" Data="{StaticResource PpIconPin}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyText" Grid.Row="3" Text="Nothing to paste yet." IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PpMuted}" />

      <TextBlock x:Name="FooterText" Grid.Row="4" Text="{Binding FooterHint}" FontSize="12" Foreground="{DynamicResource PpMuted}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    </Grid>
  </Border>
</Window>
