<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PrivatePaste.Desktop.ViewModels"
        xmlns:views="using:PrivatePaste.Desktop.Views"
        x:Class="PrivatePaste.Desktop.Views.PopupWindow"
        x:DataType="vm:PopupViewModel"
        Title="PrivatePaste history"
        WindowDecorations="None" Topmost="True" ShowInTaskbar="False" CanResize="False"
        Width="420" Height="480"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- The soft 3px glow of the newest clip (branding): accent at 16% alpha. -->
        <ResourceDictionary x:Key="Dark">
          <BoxShadows x:Key="PpGlow">0 0 0 3 #29B7A5FF</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <BoxShadows x:Key="PpGlow">0 0 0 3 #295B45D6</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource PpPanelRadius}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource PpSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PpLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource PpPanelRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.row">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PpMuted}" />
    </Style>
    <Style Selector="ListBoxItem Border.row.newest">
      <Setter Property="BorderBrush" Value="{DynamicResource PpAccent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource PpGlow}" />
    </Style>
    <Style Selector="Border.kind">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.kind, ListBoxItem:pointerover Border.kind">
      <Setter Property="Background" Value="{DynamicResource PpLine}" />
    </Style>
    <Style Selector="Path.platform">
      <Setter Property="Stroke" Value="{DynamicResource PpMuted}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- History / Pinned strip: plain borders, never focusable (the Windows popup must not take the focus). -->
    <Style Selector="Border.tab">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="{StaticResource PpControlRadius}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tab TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PpMuted}" />
    </Style>
    <Style Selector="Border.tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource PpSurface}" />
    </Style>
    <Style Selector="Border.tab.active">
      <Setter Property="Background" Value="{DynamicResource PpRaised}" />
    </Style>
    <Style Selector="Border.tab.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PpText}" />
    </Style>
    <Style Selector="Button.pin">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PpLine}" />
    </Style>
    <Style Selector="Path.pinicon">
      <Setter Property="Stroke" Value="{DynamicResource PpMuted}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.pinicon.pinned">
      <Setter Property="Stroke" Value="{DynamicResource PpAccent}" />
    </Style>
    <Style Selector="Panel.icon Path, Panel.icon Rectangle, Panel.icon Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource PpAccent}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource PpNight}" BorderBrush="{DynamicResource PpLine}" BorderThickness="1"
          CornerRadius="{StaticResource PpPanelRadius}" Padding="12">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
      <TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="Search history" />

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
        <Border x:Name="HistoryTabButton" Classes="tab" Classes.active="{Binding IsHistoryTab}" Focusable="False">
          <TextBlock Text="History" />
        </Border>
        <Border x:Name="PinnedTabButton" Classes="tab" Classes.active="{Binding IsPinnedTab}" Focusable="False">
          <TextBlock Text="Pinned" />
        </Border>
      </StackPanel>

      <ListBox x:Name="ItemsList" Grid.Row="2" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}"
               Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PopupItem">
            <Border Classes="row" Classes.newest="{Binding IsNewest}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="kind" VerticalAlignment="Top">
                  <Panel>
                    <Viewbox Width="18" Height="18">
                      <Panel Classes="icon" Width="24" Height="24">
                        <Canvas IsVisible="{Binding IsImage}">
                          <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="16" RadiusX="3" RadiusY="3" />
                          <Ellipse Canvas.Left="7" Canvas.Top="8" Width="4" Height="4" />
                          <Path Data="M21 16l-5-5-9 9" />
                        </Canvas>
                        <Canvas IsVisible="{Binding IsLink}">
                          <Path Data="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" />
                          <Path Data="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
                        </Canvas>
                        <Canvas IsVisible="{Binding IsText}">
                          <Path Data="M5 6h14M5 12h14M5 18h9" />
                        </Canvas>
                      </Panel>
                    </Viewbox>
                    <Image Source="{Binding Thumbnail, Converter={x:Static views:PopupWindow.ThumbnailConverter}}"
                           Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                    <!-- Source device platform, about the cap height of the 12px meta text. -->
                    <Viewbox x:Name="PlatformIcon" Width="13" Height="13" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding Platform.Label}" ToolTip.Tip="{Binding Platform.Label}">
                      <Canvas Width="24" Height="24">
                        <Path Classes="platform"
                              Data="{Binding Platform.ResourceKey, Converter={x:Static views:PopupWindow.ResourceConverter}}" />
                      </Canvas>
                    </Viewbox>
                    <!-- Marks a pinned clip (the button on the right toggles it). -->
                    <Viewbox Grid.Column="1" Width="13" Height="13" VerticalAlignment="Center" IsVisible="{Binding IsPinned}">
                      <Canvas Width="24" Height="24">
                        <Path Classes="pinicon pinned" Data="{StaticResource PpIconPin}" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource PpMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
                <Button Grid.Column="2" Classes="pin" AutomationProperties.Name="{Binding PinLabel}" ToolTip.Tip="{Binding PinLabel}">
                  <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                      <Path Classes="pinicon" Classes.pinned="{Binding IsPinned}" Data="{StaticResource PpIconPin}" />
                    </Canvas>
                  </Viewbox>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Nothing to paste yet." IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PpMuted}" />

      <TextBlock Grid.Row="3" Text="{Binding FooterHint}" FontSize="12" Foreground="{DynamicResource PpMuted}"
                 HorizontalAlignment="Center" />
    </Grid>
  </Border>
</Window>
