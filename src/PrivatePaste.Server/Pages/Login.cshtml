@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<form method="post" class="signin">
    <img class="logo" src="/logo.svg" alt="" asp-append-version="true">
    <p class="wordmark">private<span>paste</span></p>
    <h1>Sign in</h1>
    @if (Model.Failed)
    {
        <p class="error" role="alert">Wrong name or password.</p>
    }
    <label for="Name">Name</label>
    <input asp-for="Name" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus required>
    <label for="Password">Password</label>
    <input asp-for="Password" type="password" autocomplete="current-password" required>
    <button type="submit" class="primary">Sign in</button>
</form>
