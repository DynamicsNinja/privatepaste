@page
@model IndexModel
@{
    ViewData["Title"] = "History";
    // Only the true top of history gets the "just arrived" highlight, not the first row of a search or a later page.
    var highlightFirst = string.IsNullOrEmpty(Model.Q) && !Request.Query.ContainsKey("cursor");
    var first = true;
}
<div class="tabs" role="navigation" aria-label="History views">
    <a asp-page="/Index" asp-route-q="@Model.Q" aria-current="@(Model.PinnedTab ? null : "page")">History</a>
    <a asp-page="/Index" asp-route-tab="pinned" asp-route-q="@Model.Q" aria-current="@(Model.PinnedTab ? "page" : null)">Pinned</a>
</div>
<form method="get" class="search" role="search">
    @if (Model.PinnedTab)
    {
        <input type="hidden" name="tab" value="pinned">
    }
    <input type="search" name="q" value="@Model.Q" placeholder="@(Model.PinnedTab ? "Search pinned clips" : "Search history")" aria-label="@(Model.PinnedTab ? "Search pinned clips" : "Search history")">
    <button type="submit">Search</button>
</form>

@if (Model.Items.Count == 0)
{
    <p class="muted empty">@(!string.IsNullOrEmpty(Model.Q) ? "No clips match that search." : Model.PinnedTab ? "No pinned clips. Pin a clip to keep it through Clear history and auto-delete." : "Nothing here yet. Copy something on a signed-in device and it shows up here.")</p>
}

<ul class="clips">
@foreach (var clip in Model.Items)
{
    var kind = clip.Kind.ToString().ToLowerInvariant();
    var isPinned = clip.PinnedAt is not null;
    <li class="clip@(first && highlightFirst ? " newest" : "")" data-id="@clip.Id" data-kind="@kind">
        <span class="kind" title="@clip.Kind">
            @switch (clip.Kind)
            {
                case ClipKind.Image:
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
                    break;
                case ClipKind.Link:
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg>
                    break;
                default:
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9"/></svg>
                    break;
            }
        </span>
        <div class="body">
            @if (clip.Kind == ClipKind.Image)
            {
                <img class="thumb" src="/api/clips/@clip.Id/thumbnail" loading="lazy" alt="Image clip @clip.Width x @clip.Height">
            }
            else if (clip.Kind == ClipKind.Link && IndexModel.IsSafeUrl(clip.Text))
            {
                <a href="@clip.Text" rel="noopener noreferrer" target="_blank">@IndexModel.Preview(clip.Text)</a>
            }
            else
            {
                <pre class="text">@IndexModel.Preview(clip.Text)</pre>
            }
            <div class="meta">@if (isPinned && !Model.PinnedTab) {<span class="pin-marker" title="Pinned">@UiIcons.Pin("pin-icon")<span class="sr-only">Pinned</span></span>}@PlatformIcons.Svg(clip.SourceDevicePlatform)@clip.SourceDeviceName, <time datetime="@clip.LastCopiedAt.ToString("o")">@Model.Ago(clip.LastCopiedAt)</time></div>
        </div>
        <div class="actions">
            <button type="button" class="copy">Copy</button>
            <form method="post" asp-page-handler="@(isPinned ? "Unpin" : "Pin")" asp-route-q="@Model.Q" asp-route-tab="@Model.TabRoute">
                <input type="hidden" name="id" value="@clip.Id">
                <button type="submit" class="ghost pin-toggle" aria-pressed="@(isPinned ? "true" : "false")">@UiIcons.Pin("pin-icon")<span class="sr-only">@(isPinned ? "Unpin" : "Pin")</span></button>
            </form>
            <form method="post" asp-page-handler="Delete" asp-route-q="@Model.Q" asp-route-tab="@Model.TabRoute">
                <input type="hidden" name="id" value="@clip.Id">
                <button type="submit" class="ghost">Delete</button>
            </form>
        </div>
    </li>
    first = false;
}
</ul>

@if (Model.NextCursor is not null)
{
    <p><a class="more" asp-page="/Index" asp-route-q="@Model.Q" asp-route-tab="@Model.TabRoute" asp-route-cursor="@Model.NextCursor">Load more</a></p>
}
