@page
@model IndexModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
    ViewData["Title"] = "History";
    // Modules are loaded by URL from history.js and site.js, so they get the same content hash as asp-append-version:
    // behind Cloudflare an unversioned module could stay old while the page that loads it is new.
    string Versioned(string path) => FileVersions.AddFileVersionToPath(Request.PathBase, path);
    var searchLabel = Model.PinnedTab ? "Search pinned clips" : "Search history";
}
@* Everything below is filled in by js/history.js and js/vault-ui.js: the server never sees a clip's content. *@
<div id="history" data-page="history" data-tab="@(Model.PinnedTab ? "pinned" : "history")"
     data-e2e="@Versioned("/js/e2e.js")" data-vault-ui="@Versioned("/js/vault-ui.js")" data-history="@Versioned("/js/history.js")">

    <section class="vault-panel" id="unlock" hidden>
        <h1>Unlock your history</h1>
        <form id="unlock-form" class="passphrase-form">
            <p class="error" id="unlock-error" role="alert" hidden></p>
            <label for="unlock-passphrase">Passphrase</label>
            <input type="password" id="unlock-passphrase" autocomplete="current-password" required>
            <button type="submit" class="primary">Unlock</button>
        </form>
    </section>

    <section class="vault-panel" id="setup" hidden>
        <h1>Set up encryption</h1>
        <p class="muted hint">Use at least 12 characters. A short sentence works well.</p>
        <form id="setup-form" class="passphrase-form">
            <p class="error" id="setup-error" role="alert" hidden></p>
            <label for="setup-passphrase">Passphrase</label>
            <input type="password" id="setup-passphrase" autocomplete="new-password" required>
            <label for="setup-repeat">Repeat passphrase</label>
            <input type="password" id="setup-repeat" autocomplete="new-password" required>
            <button type="submit" class="primary">Set up</button>
        </form>
    </section>

    <p class="muted empty" id="no-vault" hidden>Ask the owner to set up encryption.</p>
    <p class="error" id="history-error" role="alert" hidden></p>

    <div id="clips-view" hidden>
        <div class="tabs" role="navigation" aria-label="History views">
            <a asp-page="/Index" aria-current="@(Model.PinnedTab ? null : "page")">History</a>
            <a asp-page="/Index" asp-route-tab="pinned" aria-current="@(Model.PinnedTab ? "page" : null)">Pinned</a>
        </div>
        <form class="search" id="search" role="search">
            <input type="search" id="search-input" name="q" value="@Model.Q" placeholder="@searchLabel" aria-label="@searchLabel">
            <button type="submit">Search</button>
        </form>
        <p class="muted empty" id="history-empty" hidden></p>
        <ul class="clips" id="clips"></ul>
        <div class="list-footer">
            <button type="button" id="load-more" hidden>Load more</button>
            <button type="button" id="search-older" hidden>Search older clips</button>
        </div>
    </div>

    <template id="clip-row">
        <li class="clip">
            <span class="kind"></span>
            <div class="body">
                <div class="meta"><span class="pin-marker" title="Pinned">@UiIcons.Pin("pin-icon")<span class="sr-only">Pinned</span></span><span class="person-chip"></span></div>
            </div>
            <div class="actions">
                <button type="button" class="copy icon-button" aria-label="Copy" title="Copy">@UiIcons.Copy("btn-icon idle-icon")@UiIcons.Check("btn-icon done-icon")</button>
                <button type="button" class="ghost pin-toggle" aria-pressed="false">@UiIcons.Pin("pin-icon")<span class="sr-only">Pin</span></button>
                <button type="button" class="ghost delete icon-button" aria-label="Delete" title="Delete">@UiIcons.Trash("btn-icon")</button>
            </div>
        </li>
    </template>
    <template id="file-line">
        <li class="file-line"><span class="file-name"></span><span class="file-size muted"></span><button type="button" class="ghost file-download icon-button" aria-label="Download" title="Download">@UiIcons.Download("btn-icon")</button></li>
    </template>
    <template id="kind-icons">
        <svg data-kind="image" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
        <svg data-kind="link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg>
        <svg data-kind="file" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5"/></svg>
        <svg data-kind="text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9"/></svg>
    </template>
    <template id="platform-icons">@foreach (var icon in PlatformIcons.All){@PlatformIcons.Svg(icon.Key)}</template>
</div>
<script type="module" src="/js/history.js" asp-append-version="true"></script>
